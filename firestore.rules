rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Round 1: one doc per product (P001..P104), one field per person: "yes" or "no".
    match /votes/{pid} {
      allow read: if true;
      allow create, update: if pid.matches('P[0-9]{3}')
        && request.resource.data.keys().hasOnly(['Ali', 'Jibran', 'Ayan'])
        && request.resource.data.values().hasOnly(['yes', 'no']);
    }

    // Round 1 of the second batch: same shape as /votes, limited to the products in batch2.json.
    match /votes2/{pid} {
      allow read: if true;
      allow create, update: if pid in ["N001", "N002", "N003", "N004", "N005", "N006", "N007", "N008", "N009", "N010", "N012", "N013", "N108", "N110", "N111", "N112", "N113", "N114", "N116", "N117", "N118", "N119", "N120", "N121", "N122", "N123", "N124", "N125", "N126", "N127", "N128", "N129", "N130", "N131", "N132", "N133", "N134", "N135", "N136", "N139", "N145", "N152", "N154", "N160", "N167", "N169", "N179", "N206", "N208", "N249", "N250", "N014", "N015", "N016", "N017", "N018", "N019", "N020", "N021", "N022", "N023", "N024", "N025", "N157", "N183", "N213", "N214", "N218", "N224", "N255", "N033", "N034", "N035", "N036", "N037", "N038", "N039", "N040", "N041", "N042", "N043", "N044", "N045", "N172", "N173", "N176", "N177", "N204", "N232", "N235", "N238", "N241", "N242", "N245", "N170", "N211", "N215", "N217", "N222", "N026", "N027", "N028", "N029", "N046", "N048", "N049", "N052", "N053", "N054", "N055", "N058", "N060", "N061", "N065", "N066", "N067", "N069", "N071", "N073", "N074", "N076", "N077", "N078", "N080", "N081", "N082", "N083", "N084", "N085", "N086", "N087", "N088", "N089", "N090", "N091", "N092", "N093", "N095", "N096", "N097", "N098", "N099", "N100", "N101", "N102", "N103", "N104", "N105", "N106", "N107", "N109", "N140", "N143", "N162", "N190", "N221", "N237", "N247", "N256", "N030", "N031", "N032", "N137", "N147", "N180", "N181", "N182", "N184", "N185", "N186", "N187", "N233", "N243", "N144", "N148", "N149", "N151", "N153", "N155", "N163", "N230", "N231"]
        && request.resource.data.keys().hasOnly(['Ali', 'Jibran', 'Ayan'])
        && request.resource.data.values().hasOnly(['yes', 'no']);
    }

    // Round 2: one doc per person, one list of picked product ids per category.
    // Generated by make_rules.py from round2.json.
    function catOk(d, k, max, allowed) {
      return !(k in d) || (d[k] is list && d[k].size() <= max && d[k].hasOnly(allowed));
    }
    match /picks/{person} {
      allow read: if true;
      allow create, update: if person in ['Ali', 'Jibran', 'Ayan']
        && request.resource.data.keys().hasOnly(["bangles", "bracelets", "rings", "earrings", "necklaces", "evileye", "handchains", "anklet"])
        && isValid(request.resource.data);
    }
    function isValid(d) {
      return true
        && catOk(d, 'bangles', 10, ["P017", "P020", "P044", "P045", "P047", "P048", "P049", "P050", "P051", "P052", "P053", "P054", "P055", "P056", "P057", "P059", "P060", "P079", "P080", "P081", "P083", "P087", "P088", "P091", "P092", "P093"])
        && catOk(d, 'bracelets', 8, ["P030", "P034", "P036", "P040", "P041", "P046", "P061", "P064", "P066", "P074", "P075", "P078", "P086", "P089", "P090", "P097", "P102"])
        && catOk(d, 'rings', 7, ["P001", "P004", "P008", "P014", "P016", "P021", "P022", "P023", "P024", "P025", "P026", "P027", "P058", "P077"])
        && catOk(d, 'earrings', 7, ["P005", "P009", "P010", "P012", "P015", "P070", "P071", "P076", "P084", "P099"])
        && catOk(d, 'necklaces', 4, ["P013", "P028", "P032", "P033", "P042", "P062", "P063"])
        && catOk(d, 'evileye', 1, ["P085", "P101", "P103"])
        && catOk(d, 'handchains', 2, ["P003", "P019", "P065", "P069"])
        && catOk(d, 'anklet', 1, ["P073"]);
    }
  }
}
