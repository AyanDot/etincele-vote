rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Round 1: one doc per product (P001..P104), one field per person: "yes" or "no".
    match /votes/{pid} {
      allow read: if true;
      allow create, update: if pid.matches('P[0-9]{3}')
        && request.resource.data.keys().hasOnly(['Ali', 'Jibran', 'Ayan'])
        && request.resource.data.values().hasOnly(['yes', 'no']);
    }

    // Round 2: one doc per person, one list of picked product ids per category.
    // Generated by make_rules.py from round2.json.
    function catOk(d, k, max, allowed) {
      return !(k in d) || (d[k] is list && d[k].size() <= max && d[k].hasOnly(allowed));
    }
    match /picks/{person} {
      allow read: if true;
      allow create, update: if person in ['Ali', 'Jibran', 'Ayan']
        && request.resource.data.keys().hasOnly(["bangles", "bracelets", "rings", "earrings", "necklaces", "evileye", "handchains", "anklet"])
        && isValid(request.resource.data);
    }
    function isValid(d) {
      return true
        && catOk(d, 'bangles', 10, ["P017", "P020", "P044", "P045", "P047", "P048", "P049", "P050", "P051", "P052", "P053", "P054", "P055", "P056", "P057", "P059", "P060", "P079", "P080", "P081", "P083", "P087", "P088", "P091", "P092", "P093"])
        && catOk(d, 'bracelets', 8, ["P030", "P034", "P036", "P040", "P041", "P046", "P061", "P064", "P066", "P074", "P075", "P078", "P086", "P089", "P090", "P097", "P102"])
        && catOk(d, 'rings', 7, ["P001", "P004", "P008", "P014", "P016", "P021", "P022", "P023", "P024", "P025", "P026", "P027", "P058", "P077"])
        && catOk(d, 'earrings', 7, ["P005", "P009", "P010", "P012", "P015", "P070", "P071", "P076", "P084", "P099"])
        && catOk(d, 'necklaces', 4, ["P013", "P028", "P032", "P033", "P042", "P062", "P063"])
        && catOk(d, 'evileye', 1, ["P085", "P101", "P103"])
        && catOk(d, 'handchains', 2, ["P003", "P019", "P065", "P069"])
        && catOk(d, 'anklet', 1, ["P073"]);
    }
  }
}
